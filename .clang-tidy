# clang-tidy configuration for project aurora

# ⚠️ Checks 是单引号标量，其内部"#"不会被视为注释（clang-tidy 会把整段当成一个未知
# 检查名并静默失效）。所有排除理由必须写成标量之外的 YAML 注释，即本处这种形式。
#
# 定向排除理由（与下方 Checks 列表中的 - 项一一对应）：
# - cppcoreguidelines-pro-type-vararg：C 可变参数是既定设计。AURORA_LOG/trace/bench
#   的 printf 风格接口刻意使用 __VA_ARGS__ 与 va_list（零开销格式化，避免为日志引入
#   <format> 编译依赖），逐点抑制无意义。
# - cppcoreguidelines-avoid-c-arrays / modernize-avoid-c-arrays /
#   cppcoreguidelines-pro-bounds-array-to-pointer-decay：Aurora 内部一律以 std::span
#   传递缓冲区，残余告警全部落在两类不可改的位置——测试夹具（const char *required[]、
#   const std::uint8_t c[4] 等字面量表）与系统 API 边界（Win32 WideCharToMultiByte
#   形参为 LPCWSTR，只能接受退化后的指针）。新增 C 数组由编码规范审查把关。
# - readability-function-cognitive-complexity / readability-avoid-nested-conditional-operator：
#   纯风格/主观阈值检查，无安全 auto-fix。残留告警全部落在测试代码（复杂 setup、
#   嵌套三元构造断言数据），对库实现无信号价值；逐点抑制噪声过大，故配置层排除，
#   库代码复杂度由 Code Review 把关。
# - bugprone-exception-escape：已开启（2026-09-22 判因收口，此前曾整体排除）。开启依据是实测规模：
#   去掉排除项全量跑，净新增 113 条；其中 91 条落在「已写却因排版错位而失效」的豁免行上（见
#   CODING_STANDARDS.md §5.2 与 check_nolint_layout 门禁），排版修复后真实残留仅 22 条，已全部
#   逐点处置并写明理由（库侧 3 处析构关停 + 2 处转入 std::function 的命令回调、测试框架入口与
#   RAII 守卫 6 处、示例/探针回调与入口 11 处）。此前「逐点噪声过大故整体排除」的理由已被该实测
#   推翻——噪声早已写在代码里，整体排除只让这些豁免变成死标记。价值面：析构 / noexcept 函数 /
#   静态初始化链上的抛出即 terminate，属本库明确要拦的崩溃类。
#   ⚠️ 本检查有一条系统性假告警面须知悉：**任何转入 std::function 的可调用对象一律判为「不应抛出」**
#   （std::function::operator() 无 noexcept 规格，分析器无法证明其不抛），故回调密集的新增代码常需
#   一枚带理由的豁免；处置口径见上述 22 处的紧邻注释。
#   ⚠️ 开启后两条口径的条数并不相同：浏览器口径另报 5 条，native 遍一条也看不见。其中 2 条落在
#   tests/framework 的头文件上，是 HeaderFilterRegex 只认正斜杠的覆盖面缺口把它滤掉了（把正则改成
#   分隔符无关后 native 同样报，实测过，故**不是** libc++ 差异）；另 3 条分属真实跨标准库差异
#   （Node::~Node 的销毁上报链、suite_from_path 内的 constexpr string_view 成员）与浏览器专属 TU
#   的入口（wasm 音频探针）。5 条按同一判因纪律逐点处置完毕，两口径各自复验 0 findings。
# - cppcoreguidelines-pro-bounds-avoid-unchecked-container-access：保持关闭（2026-09-22 实测判因）。
#   去掉排除项全量跑，修复排版错位后净新增仍达 2050 条（其中 tests 1703、库侧 src/include 273，散在
#   数十文件），逐点抑制不成比例。更关键的是它与本项目两处刻意设计冲突：① 热路径按裸下标访问并
#   以 `// NOLINT(...)` 记录契约（bidi 重排、音频环形 PCM、GPU 顶点/索引装配等处均依赖不抛的
#   operator[]，改 .at() 即引入抛出路径与额外边界检查）；② 内部缓冲区传递统一用 std::span，其
#   视图切分本身就以指针算术/下标表达。仓内已存在 225 处点名该检查的豁免，保留在代码里作为「何时
#   需要显式声明不抛」的自文档，一旦将来要开启该检查即以它们为基线。越界防护由既有
#   pro-bounds-* 与 clang-analyzer 面 + 测试承担，不靠本检查。
# - modernize-use-trailing-return-type：与 codespec/CODING_STANDARDS.md §8.3 直接冲突。
#   §8.3 明确「新增代码必须用语义化尾置返回类型，存量代码允许例外」；本项目为 C++20
#   MSVC/clang 双工具链，存量函数（含大量模板/重载）机械翻成尾置返回类型会带来巨大 diff
#   且 §8.3 已豁免存量，故配置层关闭，新增代码的尾置返回类型由 Code Review 把关。
# - cppcoreguidelines-non-private-member-variables-in-classes：与本项目 POD 式 struct 约定冲突。
#   Aurora 的公开数据载体（如 Rect/Size/Color/Metrics 等）刻意使用公开非静态成员，不提供
#   getter/setter 是设计选择（见 §2 命名规范），此 Core Guidelines 偏好(c.9/c.12)不作强制。
# - modernize-use-ranges：clang-tidy 22 对该检查的 fix-it 会为序列容器生成
#   `v.erase(std::ranges::subrange(first, last))` 形式，但 std::vector::erase 不接受
#   subrange 参数，产生无法编译的代码（实测 build 直接报 borrowed_subrange_t 非法）。
#   该检查仅作风格建议、无安全 auto-fix，故配置层关闭，相关循环改写由人工按需处理。
# - readability-convert-member-functions-to-static：clang-tidy 22 的 fix-it 在成员函数带
#   [[nodiscard]] 等属性时会把 static 插到属性之前（生成 `static [[nodiscard]] auto ...`，
#   属性落到 decl-specifiers 中间 → 直接编译失败）；且其「修复」会把公开成员函数改成 static，
#   属未预期的 API 变更。关闭后相关函数保持原签名，是否改 static 由人工按需评估。
# 注：hicpp-* 未在 Checks 中启用，故不需要对应的 -hicpp-* 排除项。
Checks: '
  -*,
  bugprone-*,
  modernize-*,
  performance-*,
  readability-*,
  cppcoreguidelines-*,
  clang-analyzer-*,
  -readability-trailing-comma,
  -readability-identifier-length,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-avoid-do-while,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-avoid-c-arrays,
  -modernize-avoid-c-arrays,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -readability-function-cognitive-complexity,
  -readability-avoid-nested-conditional-operator,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -modernize-use-trailing-return-type,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -modernize-use-ranges,
  -readability-convert-member-functions-to-static,
'
WarningsAsErrors: ''
# 头文件过滤必须**分隔符无关**：原值只认正斜杠，而 Windows 编译库里的头文件路径常是「正斜杠根 +
# 反斜杠段」的混合形态，某一段与正则不符即把该段之后的头文件诊断整片滤掉——本机 native 因此长期
# 报 0，而 Linux runner（全正斜杠）同一份代码报 422 条（wasm 口径 470）。两个数都是真话，只是
# 覆盖面不同；把正则改为 [/\\] 后本机与 CI 同面，头文件存量在本机即可复现与处置。
HeaderFilterRegex: '(include[/\\]aurora|src[/\\]aurora|[/\\]tests[/\\]|[/\\]tools[/\\]|[/\\]examples[/\\])'
FormatStyle: file
ExtraArgs: [ '-std=c++20' ]
CheckOptions:
  # 类/结构体/联合体/枚举类型
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.UnionCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase

  # 函数/方法
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.MethodCase
    value: lower_case

  # 局部变量
  - key: readability-identifier-naming.LocalVariableCase
    value: lower_case

  # 全局变量
  # ⚠️ clang-tidy 22 把「类内 `static inline`（含 thread_local）数据成员」也归入 GlobalVariable 类
  # （实测探针：`struct K { static inline bool enabled_; }` 报的是 global variable，而非
  # ClassStatic/Member）。本仓这类成员一律按成员惯例以 `_` 收尾，故给 GlobalVariable 加
  # 「以 `_` 结尾者豁免」。注意 IgnoredRegexp 是**整串匹配**语义（`_$` 无效，`.*_` 才生效，均已实测），
  # 且只放宽「大小写风格」这一维：`otherCamel` 这类真全局仍照常告警（同一探针的负例验证过）。
  - key: readability-identifier-naming.GlobalVariableCase
    value: lower_case
  - key: readability-identifier-naming.GlobalVariableIgnoredRegexp
    value: '.*_'

  # 形参
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: readability-identifier-naming.ConstantParameterCase
    value: lower_case

  # 非静态成员变量（尾部下划线）
  - key: readability-identifier-naming.MemberCase
    value: lower_case
  - key: readability-identifier-naming.ProtectedMemberSuffix
    value: '_'
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: '_'

  # 静态成员变量
  - key: readability-identifier-naming.ClassStaticCase
    value: lower_case
  - key: readability-identifier-naming.ClassStaticProtectedMemberSuffix
    value: '_'
  - key: readability-identifier-naming.ClassStaticPrivateMemberSuffix
    value: '_'

  # 全局常量（AURORA_ 前缀 + 全大写）
  - key: readability-identifier-naming.GlobalConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: 'AURORA_'

  # 静态成员常量（全大写无前缀）
  - key: readability-identifier-naming.StaticConstantCase
    value: UPPER_CASE

  # 局部常量（lower_case）
  - key: readability-identifier-naming.LocalConstantCase
    value: lower_case

  # 枚举常量（CamelCase 无前缀）
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase

  # 类型别名/typedef
  - key: readability-identifier-naming.TypeAliasCase
    value: CamelCase
  - key: readability-identifier-naming.TypedefCase
    value: CamelCase

  # 命名空间（lower_case）
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case

  # 模板参数（CamelCase）
  - key: readability-identifier-naming.TemplateParameterCase
    value: CamelCase

  # 宏定义（AURORA_ 前缀 + 全大写）
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
  - key: readability-identifier-naming.MacroDefinitionPrefix
    value: 'AURORA_'